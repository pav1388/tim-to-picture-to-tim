// win_icon.rc

#include <windows.h>

#define IDI_ICON1 101
#define IDI_ICON2 102

IDI_ICON1 ICON "icon.ico"
IDI_ICON2 ICON "icon-ttptt.ico"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION     1,0,0,0
    PRODUCTVERSION  1,0,0,0
    FILEFLAGSMASK   0x3fL
    FILEFLAGS       0x0L
    FILEOS          VOS_NT_WINDOWS32
    FILETYPE        VFT_APP
    FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "pav13"
            VALUE "FileDescription",  "tim-to-picture-to-tim"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "ttptt"
            VALUE "OriginalFilename", "ttptt.exe"
            VALUE "ProductName",      "ttptt"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END